{
  "name": "pixel-keep",
  "version": "0.1.0",
  "description": "A customizable React pixel art component library.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pixel",
    "pixel-art",
    "react",
    "components",
    "pixel-keep"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles/pixel-art.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pixel-keep/core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3"
  }
}
