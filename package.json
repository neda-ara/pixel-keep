{
  "name": "pixel-keep",
  "version": "0.1.0",
  "description": "A customizable React pixel art component libray.",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "keywords": [
    "pixel-art",
    "component-library",
    "react",
    "typescript"
  ],
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev",
